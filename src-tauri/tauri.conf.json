{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "inv_frontend",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "VITE_USE_DEV_PROXY=false npm run dev",
    "beforeBuildCommand": "VITE_USE_DEV_PROXY=false npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "inv_frontend",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: https://asset.localhost; connect-src 'self' ipc: http://*:*; img-src 'self' asset: data: blob: http://*:*; media-src 'self' blob: http://*:*;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
