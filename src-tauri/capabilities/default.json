{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "http:default",
    "cors-fetch:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        {
          "url": "http://*/*"
        }
      ]
    },
    {
      "identifier": "cors-fetch:allow-fetch",
      "allow": [
        "http://*/*"
      ]
    }
  ]
}
